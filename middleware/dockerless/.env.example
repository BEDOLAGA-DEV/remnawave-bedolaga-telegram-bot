# hwid-blocker environment — Dockerless deployment.
#
# Copy to .env (next to this file) or export these in your shell / systemd
# EnvironmentFile before running. See ../README.md for details.

# Where the proxy listens (nginx / subscription path). Fatal if it cannot bind.
LISTEN_ADDR=127.0.0.1:3020

# Optional secondary listener so a containerized bot (bridge network) can push
# state without exposing 3020 publicly. Leave empty if the bot is on the host.
BOT_LISTEN_ADDR=172.22.0.1:3020

# The Remnawave subscription page (everything non-blocked is proxied here).
UPSTREAM_URL=http://127.0.0.1:3010

# Where the state snapshot is persisted. Default: <middleware>/data/state.json
STATE_FILE=

# Admin token required for PUT /v1/state. Must match the bot's MIDDLEWARE_ADMIN_TOKEN.
ADMIN_TOKEN=

# Bot webapi used for the startup bootstrap pull (GET /device-blocks).
BOT_API_URL=http://127.0.0.1:8080

# Token accepted by the bot webapi for the bootstrap pull.
BOT_API_TOKEN=

# If the state file cannot be read, start with an empty block list (true)
# instead of refusing to start (false).
FAIL_OPEN=true

# Optional: a vless:// link served as the single server of the synthetic
# blocked profile, so clients that reject an empty server list still load a
# valid config. Leave empty to keep the legacy empty profile.
BLOCKED_FALLBACK_SERVER=
