# Copy to .env and fill in real values (see ../README.md -> "Bot integration").
#
# MIDDLEWARE_ADMIN_TOKEN must EXACTLY match the bot's MIDDLEWARE_ADMIN_TOKEN,
# otherwise the bot's state pushes (PUT /v1/state) are rejected with 401.
# BOT_API_TOKEN_FOR_MIDDLEWARE must be a valid token accepted by the bot webapi
# (used by the middleware's startup bootstrap pull, GET /device-blocks).
MIDDLEWARE_ADMIN_TOKEN=
BOT_API_TOKEN_FOR_MIDDLEWARE=
