ption":"Нет доступа (tier_too_low, api_not_available)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GeoError"}}}},"500":{"description":"Внутренняя ошибка (назовите request_id)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GeoError"}}}},"404":{"description":"Прогон не найден","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GeoError"}}}}}},"delete":{"tags":["v1-geo"],"summary":"Удалить прогон из истории","description":"Удалить ЗАВЕРШЁННЫЙ прогон. Идущий не удаляем: он продолжит тратить деньги, а\nиз гейта параллельных запусков исчезнет — отвечаем 409, чтобы это было видно.","operationId":"geo_run_delete_v1_geo_runs__run_id__delete","parameters":[{"name":"run_id","in":"path","required":true,"schema":{"type":"integer","title":"Run Id"}},{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"type":"object","additionalProperties":true,"title":"Response Geo Run Delete V1 Geo Runs  Run Id  Delete"}}}},"422":{"description":"Тело запроса не прошло валидацию","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GeoError"}}}},"400":{"description":"Некорректный запрос (invalid_request, unknown_city, port_not_allowed, too_many_nodes, …)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GeoError"}}}},"401":{"description":"Нет ключа, ключ неверен или отозван","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GeoError"}}}},"403":{"description":"Нет доступа (tier_too_low, api_not_available)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GeoError"}}}},"500":{"description":"Внутренняя ошибка (назовите request_id)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GeoError"}}}},"404":{"description":"Прогон не найден","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GeoError"}}}},"409":{"description":"Прогон ещё идёт (run_in_progress)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GeoError"}}}}}}},"/v1/geo/runs/{run_id}/cancel":{"post":{"tags":["v1-geo"],"summary":"Остановить идущий прогон","description":"Прекратить проверку досрочно. Бесплатно, без Idempotency-Key, повторный вызов безопасен.\n\nДеньги: гасится НЕсделанная работа. Города, которые уже проверены, остаются в отчёте и\nостаются платными — их трафик через резидентные выходы уже израсходован; неиспользованный\nостаток резерва возвращается, как при обычном завершении. Если чекер уже начал (событие\nstart) — минимум 1 кредит: первые города уже в работе; отмена до старта — весь резерв назад.","operationId":"geo_run_cancel_v1_geo_runs__run_id__cancel_post","parameters":[{"name":"run_id","in":"path","required":true,"schema":{"type":"integer","title":"Run Id"}},{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"type":"object","additionalProperties":true,"title":"Response Geo Run Cancel V1 Geo Runs  Run Id  Cancel Post"}}}},"422":{"description":"Тело запроса не прошло валидацию","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GeoError"}}}},"400":{"description":"Некорректный запрос (invalid_request, unknown_city, port_not_allowed, too_many_nodes, …)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GeoError"}}}},"401":{"description":"Нет ключа, ключ неверен или отозван","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GeoError"}}}},"403":{"description":"Нет доступа (tier_too_low, api_not_available)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GeoError"}}}},"500":{"description":"Внутренняя ошибка (назовите request_id)","content":{"applica