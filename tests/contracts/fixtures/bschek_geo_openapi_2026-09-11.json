o (тот же на 4xx и 5xx)"}},"securitySchemes":{"bearerApiKey":{"type":"http","scheme":"bearer","description":"API-ключ bsk_live_… (Кабинет → API, тариф Bronze+)"}}},"security":[{"bearerApiKey":[]}]}