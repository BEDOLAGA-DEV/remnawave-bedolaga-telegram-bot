ponents/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"ResolveBody":{"properties":{"url":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Url","description":"ссылка подписки (https://…)","examples":["https://panel.example.com/sub/abc"]}},"additionalProperties":true,"type":"object","title":"ResolveBody"},"RunBody":{"properties":{"targets":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}],"title":"Targets","description":"что проверяем: домены/URL/IP и/или одна ссылка vless:// / hysteria2:// — можно вместе (сайт-цели идут напрямую с резидентного выхода, туннель проверяется служебными URL)","examples":[["https://example.com"]]},"network":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Network","description":"'res' — домашний интернет (деф.) | 'mob' — мобильный"},"isp":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Isp","description":"токен провайдера из GET /v1/geo/catalog; пусто = случайный в городе; '__ALL__' (с district/region/cities) = по пробе на каждого провайдера города"},"district":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"District","description":"охват «округ»: ЦФО/СЗФО/ЮФО/СКФО/ПФО/УФО/СФО/ДФО либо латинские коды cfo/szfo/yufo/skfo/pfo/urfo/sfo/dfo — принимаются оба варианта; krym и kgd из /v1/operators здесь НЕ принимаются"},"region":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Region","description":"охват «регион»: region-токен из GET /v1/geo/catalog"},"cities":{"anyOf":[{"items":{},"type":"array"},{"type":"null"}],"title":"Cities","description":"точный список: [{region,city,isp?}] или [[region,city,isp?]]"},"city_limit":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"City Limit","description":"потолок ЧИСЛА ПРОБ (как пакет «Города: N»); 0/нет = все"},"probe_mode":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Probe Mode","description":"сайт-проба: 'tls' (хендшейк, деф.) | 'tcp' (чистый connect, дешевле)"},"heavy":{"anyOf":[{"