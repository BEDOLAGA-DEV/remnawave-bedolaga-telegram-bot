# Имя ноды в точности как в панели Remnawave (поле «Name» ноды)
NODE_NAME=NODE-1

# Адрес кабинета, без завершающего слэша
CABINET_URL=https://cabinet.example.com

# Общий секрет счётчика: передаётся в заголовке X-Location-Counter-Token
# и солит хеши пользователей и устройств. Должен совпадать с LOCATION_COUNTER_TOKEN
# в .env бота и быть одинаковым на всех нодах — иначе устройства не сведутся между ними.
LOCATION_COUNTER_TOKEN=change-me

# Необязательно. Префикс тегов outbound'ов, которые считаются выходами для разбивки
# на карточке (например, мосты на другие ноды за балансиром). В отчёт идёт тег без
# префикса: при EXIT_OUTBOUND_PREFIX=BRIDGE_ outbound BRIDGE_DE1 показывается как DE1.
# Пусто = выходы не отслеживаются.
# EXIT_OUTBOUND_PREFIX=

# Необязательно. Контейнер ноды и путь к логу xray внутри него (по умолчанию — как в remnanode)
# XRAY_CONTAINER=remnanode
# XRAY_ACCESS_LOG=/var/log/xray/current
