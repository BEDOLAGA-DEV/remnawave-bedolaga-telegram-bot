[Unit]
Description=Счётчик устройств по локациям (access-лог xray -> кабинет)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/location-counter.env
ExecStart=/usr/bin/python3 /opt/location-counter/location_counter.py
Restart=always
RestartSec=10
RestartPreventExitStatus=2
Nice=10
MemoryMax=150M
CPUQuota=25%

[Install]
WantedBy=multi-user.target
