AISUP_BOT_TOKEN=your_ai_support_bot_token
AISUP_ADMIN_IDS=123456789

AISUP_OPENAI_API_KEY=sk-your-openai-key
AISUP_OPENAI_BASE_URL=https://api.openai.com/v1
AISUP_MODEL=gpt-4o-mini
AISUP_EMBEDDING_MODEL=text-embedding-3-small
AISUP_VISION_ENABLED=true
AISUP_MAX_TOKENS=700
AISUP_TEMPERATURE=0.3
AISUP_TOP_K=5
AISUP_MIN_SCORE=0.25
AISUP_CHUNK_MAX_CHARS=1200
AISUP_CONTEXT_MESSAGES=6
AISUP_HISTORY_LIMIT=100
AISUP_DAILY_MESSAGE_LIMIT=0

AISUP_SUMMARY_ENABLED=true
AISUP_SUMMARY_EVERY_N_TURNS=3
AISUP_SUMMARY_MAX_TOKENS=220
AISUP_SUMMARY_MODEL=
AISUP_MAX_QUESTION_CHARS=1500
AISUP_KB_MIN_QUESTION_CHARS=6
AISUP_KB_DROP_LOW_VALUE=true

AISUP_DATABASE_URL=postgresql+asyncpg://remnawave_user:secure_password_123@postgres:5432/ai_support
AISUP_MAIN_DATABASE_URL=postgresql+asyncpg://remnawave_user:secure_password_123@postgres:5432/remnawave_bot

AISUP_INCLUDE_REMNAWAVE_DATA=true
AISUP_REMNAWAVE_API_URL=https://panel.example.com
AISUP_REMNAWAVE_API_TOKEN=your_remnawave_api_token

AISUP_ADMIN_HOST=0.0.0.0
AISUP_ADMIN_PORT=8090
AISUP_ADMIN_USERNAME=admin
AISUP_ADMIN_PASSWORD=change_this_password
AISUP_ADMIN_SECRET_KEY=change_this_to_random_long_string
